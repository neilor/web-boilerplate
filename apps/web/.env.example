# Copy to .env.local and adjust. Only non-secret values belong here; real deployments inject their own.
# Base URL the Next server uses to call the API.
API_BASE_URL=http://127.0.0.1:4010
# Base URL the browser uses to call the API (may differ from the server's, e.g. behind a proxy).
PUBLIC_API_BASE_URL=http://127.0.0.1:4010
# Environment name. It is part of every cache key.
API_ENVIRONMENT=local
